# ─────────────────────────────────────────────────────────────────────────────
# Flash Loan Arbitrage — Root Environment Variables
# Copy to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Polygon mainnet HTTP RPC endpoint
POLYGON_RPC_URL=

# Polygon Mumbai testnet RPC endpoint
MUMBAI_RPC_URL=

# Deployer private key (no 0x prefix)
PRIVATE_KEY=

# Polygonscan API key for contract verification
POLYGONSCAN_API_KEY=

# CoinMarketCap API key for gas reporter USD conversion
CMC_API_KEY=

# Enable gas reporting in tests (true/false)
REPORT_GAS=true
